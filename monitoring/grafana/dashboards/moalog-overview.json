      "title": "Request Rate by Status",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (status) (rate(axum_http_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
