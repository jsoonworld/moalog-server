      "title": "Request Rate by Endpoint (Top 10)",
      "type": "timeseries",
      "targets": [
        { "expr": "topk(10, sum by (endpoint) (rate(axum_http_requests_total[5m])))", "legendFormat": "{{endpoint}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 } ] } }, "overrides": [] },
