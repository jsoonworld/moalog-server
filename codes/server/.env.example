# ============================================================
# moalog-server 환경변수
# ============================================================
# 이 파일을 .env로 복사하여 사용하세요:
#   cp .env.example .env
#
# Docker 환경에서는 docker-compose.yaml에 기본값이 설정되어 있으므로
# .env 파일 없이도 `docker compose up`이 동작합니다.
# 아래 값들은 로컬 개발 환경에서 직접 `cargo run`할 때 필요합니다.
# ============================================================

# --- Database ---
# 로컬 개발:  mysql://root:@localhost:3306/retrospect
# Docker:    docker-compose.yaml에서 자동 설정됨
DATABASE_URL=mysql://root:@localhost:3306/retrospect
DB_SCHEMA_UPDATE=false

# --- Server ---
SERVER_PORT=8080

# --- CORS ---
# 쉼표(,)로 구분된 허용 오리진 목록
# 미설정 시 기본값: localhost:3000, localhost:5173, localhost:5174, moalog.me, www.moalog.me, moaofficial.kr
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# --- Logging ---
# 개발 환경 (상세 디버그 로그)
RUST_LOG=info,server=debug
# 프로덕션 (info 레벨만)
# RUST_LOG=info

# --- Security ---
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=1800
REFRESH_TOKEN_EXPIRATION=1209600
SIGNUP_TOKEN_EXPIRATION=600

# --- Social Login ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# --- AI Service ---
OPENAI_API_KEY=your_openai_api_key_here

# --- PDF Generation ---
PDF_FONT_DIR=./fonts
PDF_FONT_FAMILY=NanumGothic

# --- Monitoring (Optional) ---
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
GITHUB_TOKEN=your_github_token_here
DIAGNOSTIC_MODEL=gpt-4o-mini

# --- Docker (docker-compose.yaml에서만 사용) ---
# MYSQL_ROOT_PASSWORD=moalog_local
# MYSQL_DATABASE=retrospect
# MYSQL_PORT=3306

# --- E2E Test ---
E2E_TEST_EMAIL="testemail"
